# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / Vite
node_modules/
dist/
backend/static/

# Env / secrets
.env
.env.local
*.log

# Google OAuth client-secrets downloads. The bootstrap in app/google_oauth.py
# takes one via --client-secrets and the app keeps NO token cache on disk, so
# these should be used from ~/Downloads and deleted — never parked in the repo.
# This is the backstop for when that discipline slips: one stray `git add -A`
# would otherwise publish a live credential to a public repo. No leading slash,
# so it matches at any depth.
client_secret*.json
client_secrets*.json

# OS
.DS_Store

# Local tooling / archives (not tracked). Code snapshots must NEVER be committed
# — jarvis.tar.gz landed in history on day one and still can't be fully removed.
.claude/
*.zip
*.tar.gz
*.tgz
